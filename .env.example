# Database
DB_PORT=3307
DB_NAME=dadot_db
DB_USERNAME=dadot_app
DB_PASSWORD=dadot_local_password
DB_ROOT_PASSWORD=dadot_root_local_password

# Authentication
# 각각 openssl rand -base64 32로 생성
AUTH_PROOF_ENCRYPTION_KEY=
AUTH_VERIFICATION_HMAC_SECRET=
JWT_SECRET_BASE64=

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Links
PRIVACY_POLICY_URL=
INQUIRY_FORM_URL=

# OpenAI
OPENAI_API_KEY=

# AI Quiz Generation
app.quiz-generation.enabled=false
app.quiz-generation.worker-enabled=false
app.quiz-generation.model=gpt-6-luna

# AI Interview Generation
app.interview-generation.enabled=false
app.interview-generation.worker-enabled=false
app.interview-generation.model=gpt-6-luna

# AI Interview Evaluation
app.interview-evaluation.enabled=false
app.interview-evaluation.worker-enabled=false
app.interview-evaluation.model=gpt-6-luna