# Example only. Do not put real secrets in Git.
# Raw Docker env_file format: do not wrap values in quotes.
# configure.sh init creates the actual root-only /etc/dadot/app.env.
DADOT_CONFIG_VERSION=1
DB_URL=jdbc:mariadb://dadot-db-prod.cl22kouek0ek.ap-northeast-2.rds.amazonaws.com:3306/dadot_db?sslMode=verify-full&serverSslCert=/run/certs/rds-ca.pem
DB_USERNAME=dadot_app
DB_PASSWORD=
JWT_SECRET_BASE64=
AUTH_PROOF_ENCRYPTION_KEY=
AUTH_VERIFICATION_HMAC_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Bootstrap-only placeholders. Replace before public service.
PRIVACY_POLICY_URL=https://example.invalid/privacy
INQUIRY_FORM_URL=https://example.invalid/inquiry