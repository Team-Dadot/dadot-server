# Example only. Do not put real secrets in Git.
# Raw Docker env_file format: do not wrap values in quotes.
# configure.sh init creates the actual root-only /etc/dadot/app.env.
DADOT_CONFIG_VERSION=1
DB_URL=jdbc:mariadb://dadot-db-prod.cl22kouek0ek.ap-northeast-2.rds.amazonaws.com:3306/dadot_db?sslMode=verify-full&serverSslCert=/run/certs/rds-ca.pem
DB_USERNAME=dadot_app
DB_PASSWORD=
JWT_SECRET_BASE64=
AUTH_PROOF_ENCRYPTION_KEY=
AUTH_VERIFICATION_HMAC_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Bootstrap-only placeholders. Replace before public service.
PRIVACY_POLICY_URL=https://example.invalid/privacy
INQUIRY_FORM_URL=https://example.invalid/inquiry

# Service credentials. Fill actual values only in /etc/dadot/app.env.
DART_API_KEY=
OPENAI_API_KEY=
KAKAO_APP_ID=0
KAKAO_ADMIN_KEY=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/run/secrets/apple-signin.p8

# Feature switches. Bootstrap defaults are disabled.
APP_DART_ENABLED=false
APP_DART_WORKER_ENABLED=false
APP_DART_ORIGINALS_ENABLED=false
APP_QUIZ_GENERATION_ENABLED=false
APP_QUIZ_GENERATION_WORKER_ENABLED=false
APP_INTERVIEW_GENERATION_ENABLED=false
APP_INTERVIEW_GENERATION_WORKER_ENABLED=false
APP_INTERVIEW_EVALUATION_ENABLED=false
APP_INTERVIEW_EVALUATION_WORKER_ENABLED=false
APP_ACCOUNT_DELETION_WORKER_ENABLED=false